# ============================================================
# RODEOS Semantic Model Generator — configuration
# Copy this file to .env and fill in your values:  cp .env.example .env
# ============================================================

# --- LLM provider -------------------------------------------------
# "openrouter" (default, remote) or "ollama" (fully local)
RODEOS_LLM_PROVIDER=openrouter

# --- OpenRouter (default / reference setup) -----------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Reference model used for AI autofill (any OpenRouter model id)
RODEOS_DEFAULT_MODEL=anthropic/claude-sonnet-5

# PDF parsing engine for LLM-based document extraction via OpenRouter:
# "mistral-ocr" (OCR, handles scanned datasheets — same engine as the
# original RODEOS pipeline) or "pdf-text" (free, born-digital PDFs only)
RODEOS_PDF_ENGINE=mistral-ocr

# --- Ollama (local alternative) -----------------------------------
# Requires a running Ollama server: https://ollama.com  ("ollama serve")
OLLAMA_BASE_URL=http://localhost:11434
RODEOS_LOCAL_MODEL=qwen2.5:3b
