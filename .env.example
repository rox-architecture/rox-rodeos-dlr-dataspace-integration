# ============================================================
# RODEOS Semantic Model Generator — configuration
#
#   cp .env.example .env     # then fill in the values below
#
# Nothing here is required to start the app: it boots without any key and
# shows in the UI what is missing. The AI autofill needs an LLM provider,
# asset registration needs the dataspace section.
#
# Never commit the filled-in .env — it is gitignored, and .dockerignore keeps
# it out of the image, so keys are supplied at run time instead.
# ============================================================


# ------------------------------------------------------------
# 1) LLM provider — needed for the AI autofill
# ------------------------------------------------------------
# Which provider the UI preselects: "openrouter" or "ollama". Additional
# providers (IONOS AI Model Hub, OpenAI, vLLM, LM Studio, an internal
# gateway — anything speaking the OpenAI protocol) are added at run time in
# the app under /settings; no entry here and no restart needed.
RODEOS_LLM_PROVIDER=openrouter

# --- OpenRouter (reference setup) ---
# Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model used by default — any OpenRouter model id. Pick one that fits your
# budget: the autofill prompt carries both models and runs to a few thousand
# tokens per call. A cheap and adequate alternative is openai/gpt-4o-mini.
RODEOS_DEFAULT_MODEL=anthropic/claude-opus-5

# PDF parsing engine for uploaded documents (OpenRouter only):
# "mistral-ocr" (OCR, also reads scanned datasheets — the engine the original
# RODEOS pipeline used) or "pdf-text" (free, born-digital PDFs only)
RODEOS_PDF_ENGINE=mistral-ocr

# --- Ollama (fully local alternative, no key) ---
# Requires a running server: https://ollama.com  ("ollama serve")
# In Docker, localhost is the container itself — use host.docker.internal or
# the host's IP to reach an Ollama running on the host.
OLLAMA_BASE_URL=http://localhost:11434
RODEOS_LOCAL_MODEL=qwen2.5:3b


# ------------------------------------------------------------
# 2) Runtime provider settings (the /settings page)
# ------------------------------------------------------------
# Where providers added through the UI are stored. The directory must be
# writable by the server process; in Docker this is the /app/data volume.
# RODEOS_SETTINGS_PATH=data/settings.json

# Set to true for any deployment reachable by more than its operator: the
# /settings page becomes read-only, providers can then only be configured
# through this file, and the connection test is limited to them.
# RODEOS_SETTINGS_LOCKED=false


# ------------------------------------------------------------
# 3) DLR dataspace — needed to register assets
# ------------------------------------------------------------
# Used by "Register asset in Data Space": uploads the generated instance to
# your connector storage and creates a data offer for it.
# Dashboard: https://vision-x-dataspace.base-x-ecosystem.org/#/dashboard
# API docs:  https://vision-x-api.base-x-ecosystem.org/docs
DATASPACE_API_URL=https://vision-x-api.base-x-ecosystem.org

# Your personal API key (Bearer token) for the dataspace API
DATASPACE_API_KEY=

# Name of your connector as shown in the dashboard. It must be storage-backed
# (Amazon S3 / Azure Storage) — HttpData connectors cannot store files.
DATASPACE_CONNECTOR=

# Optional: pin the policies used for new offers. If unset, the connector's
# first existing policy is reused; if it has none, a permissive default
# access policy is created automatically.
DATASPACE_ACCESS_POLICY_ID=
DATASPACE_CONTRACT_POLICY_ID=


# ------------------------------------------------------------
# 4) Server
# ------------------------------------------------------------
# Port for `npm run start`, `npm run kiosk` and the container.
# PORT=3000
