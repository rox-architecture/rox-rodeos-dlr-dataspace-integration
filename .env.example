# ============================================================
# RODEOS Semantic Model Generator — configuration
# Copy this file to .env and fill in your values:  cp .env.example .env
# ============================================================

# --- LLM provider -------------------------------------------------
# The default provider for the AI autofill: "openrouter" or "ollama".
# Further providers — the IONOS AI Model Hub, OpenAI, vLLM, LM Studio or any
# other OpenAI-compatible endpoint — are added at runtime under /settings in
# the app; no restart and no entry here required.
RODEOS_LLM_PROVIDER=openrouter

# Where /settings stores its provider configuration (relative to the working
# directory of the server). Keys entered there stay on the server.
# RODEOS_SETTINGS_PATH=data/settings.json

# Set to true on a shared deployment to make /settings read-only, so the
# providers can only be configured through this file.
# RODEOS_SETTINGS_LOCKED=false

# --- OpenRouter (default / reference setup) -----------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Reference model used for AI autofill (any OpenRouter model id)
RODEOS_DEFAULT_MODEL=anthropic/claude-sonnet-5

# PDF parsing engine for LLM-based document extraction via OpenRouter:
# "mistral-ocr" (OCR, handles scanned datasheets — same engine as the
# original RODEOS pipeline) or "pdf-text" (free, born-digital PDFs only)
RODEOS_PDF_ENGINE=mistral-ocr

# --- Ollama (local alternative) -----------------------------------
# Requires a running Ollama server: https://ollama.com  ("ollama serve")
OLLAMA_BASE_URL=http://localhost:11434
RODEOS_LOCAL_MODEL=qwen2.5:3b

# --- DLR dataspace (Vision-X / base-x-ecosystem) ------------------
# Used by "Register asset in Data Space": uploads the generated instance
# to your connector storage and creates a data offer for it.
# Dashboard: https://vision-x-dataspace.base-x-ecosystem.org/#/dashboard
# API docs:  https://vision-x-api.base-x-ecosystem.org/docs
DATASPACE_API_URL=https://vision-x-api.base-x-ecosystem.org
# Your personal API key (Bearer token) for the dataspace API
DATASPACE_API_KEY=
# Name of your connector in the dataspace (as shown in the dashboard)
DATASPACE_CONNECTOR=
# Optional: reuse specific policies for new offers. If unset, the first
# existing policy of the connector is used; if none exists, a permissive
# default access policy is created automatically.
DATASPACE_ACCESS_POLICY_ID=
DATASPACE_CONTRACT_POLICY_ID=
